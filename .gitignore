# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# generated native folders (CNG) — root only, so modules/*/android stays tracked
/ios
/android

# local native module build output
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/

# build artifacts (eas build --local, expo export)
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# EAS local credentials
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# testing
coverage/

# macOS
.DS_Store
*.pem

# env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code (shared settings.json stays tracked)
.claude/settings.local.json

# Local snapshots made before big changes (not part of the app)
_backup/

# real SMS exports for local testing — never commit
/private/
