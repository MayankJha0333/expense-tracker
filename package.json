{
  "name": "kharcha",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-in-app-updates": "^0.13.0",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:playstore": "npx eas-cli@latest build --platform android --profile production",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "npx tsx scripts/golden.ts",
    "e2e": "maestro test .maestro",
    "check:version": "npx tsx scripts/check-version.ts",
    "release:patch": "npx tsx scripts/bump-version.ts patch --push",
    "release:minor": "npx tsx scripts/bump-version.ts minor --push",
    "release:major": "npx tsx scripts/bump-version.ts major --push",
    "bump:patch": "npx tsx scripts/bump-version.ts patch --commit",
    "lint": "expo lint",
    "web": "expo start --web",
    "privacy:md": "npx tsx scripts/privacy-md.ts",
    "scan:sms": "npx tsx scripts/scan-sms.ts",
    "test:parser": "vitest run tests/parser.test.ts",
    "test:tracking": "vitest run tests/tracking.test.ts",
    "test:currency": "vitest run tests/currency.test.ts",
    "test:update": "vitest run tests/update.test.ts",
    "test:flows": "vitest run tests/flows.test.ts",
    "test:month": "vitest run tests/month.test.ts",
    "test:cards": "vitest run tests/cards.test.ts",
    "test:invest": "vitest run tests/invest.test.ts",
    "update:production": "npx eas-cli@latest update --channel production --environment production --platform android"
  },
  "private": true
}
